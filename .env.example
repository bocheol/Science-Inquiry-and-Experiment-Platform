# 실제 값은 .env.local 또는 Cloud Run Secret Manager에만 저장합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
SESSION_SECRET=32자-이상의-무작위-문자열
# 일반 PostgreSQL 또는 로컬 Cloud SQL Auth Proxy 연결용
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=false

# Cloud Run + Cloud SQL Unix 소켓 연결용. DATABASE_URL 대신 사용합니다.
INSTANCE_UNIX_SOCKET=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
DB_USER=science_app
DB_PASSWORD=
DB_NAME=science_platform

# Google Sheets: Cloud Run에서는 서비스 계정에 시트 편집 권한을 부여하고
# 기본 애플리케이션 자격 증명을 사용합니다.
GOOGLE_SPREADSHEET_ID=1Ia5xoZZDv3b4sVq3la8POFNE_QVHEuLhitS-YC_QBVg
# 로컬에서는 JSON 파일 경로를 사용하세요. JSON 내용 자체를 채팅이나 코드에 붙여 넣지 않습니다.
GOOGLE_APPLICATION_CREDENTIALS=C:\절대경로\service-account-google.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# 최초 교사 계정. 운영 배포 전에 반드시 변경합니다.
BOOTSTRAP_TEACHER_LOGIN=teacher
BOOTSTRAP_TEACHER_PASSWORD=
ACADEMIC_YEAR=2026
